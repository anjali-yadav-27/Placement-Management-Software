<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel - Placements</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Admin Dashboard - Received Applications</h2>
            <a href="/" class="btn btn-outline-light btn-sm">View Student Portal</a>
        </div>
        
        <table class="table table-dark table-striped table-hover shadow">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Student Name</th>
                    <th>Company</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% applications.forEach(app => { %>
                    <tr>
                        <td><%= app.id %></td>
                        <td><%= app.studentName %></td>
                        <td><%= app.companyName %></td>
                        <td><span class="badge bg-warning text-dark"><%= app.status %></span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>